# Copy to .env.local for `npm run dev`, and set the same names in the Vercel project.

# The iOS app sends this as X-App-Token. Not pill-check's token: a value of its own.
APP_TOKEN=
# The dashboard sends this as its key. Open the dashboard once with /#key=<this value>.
DASHBOARD_KEY=

# Upstash Redis, set by Vercel's Upstash integration. Without them, `npm run dev` keeps
# everyone in memory until it stops; on Vercel the API refuses to run without them.
KV_REST_API_URL=
KV_REST_API_TOKEN=
